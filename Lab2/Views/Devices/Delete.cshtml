@model Lab2.Models.Device

@{
    ViewData["Title"] = "Delete Device";
}

<h2>Delete Device</h2>

<div class="alert alert-warning">
    Are you sure you want to delete this device?
</div>

<dl class="row">
    <dt class="col-sm-3">Device Name</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">Device Code</dt>
    <dd class="col-sm-9">@Model.Code</dd>

    <dt class="col-sm-3">Category</dt>
    <dd class="col-sm-9">@Model.Category?.Name</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>

    <dt class="col-sm-3">Date of Entry</dt>
    <dd class="col-sm-9">
        @Model.DateOfEntry.ToString("dd/MM/yyyy")
    </dd>
</dl>

<form asp-action="Delete"
      asp-route-id="@Model.Id"
      method="post">

    <button type="submit" class="btn btn-danger">
        Confirm Delete
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>
</form>