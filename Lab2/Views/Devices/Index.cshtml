@model IEnumerable<Lab2.Models.Device>
@using Lab2.Models

@{
    ViewData["Title"] = "Device Management";

    string searchString = ViewBag.SearchString ?? "";
    DeviceStatus? selectedStatus = ViewBag.SelectedStatus;
}

<h2>Device Management</h2>

<a asp-action="Create" class="btn btn-primary mb-3">
    Add New Device
</a>

<!-- SEARCH AND FILTER FORM -->
<form asp-controller="Devices"
      asp-action="Index"
      method="get"
      class="mb-4">

    <div class="row g-3">

        <!-- Search by Name or Code -->
        <div class="col-md-4">
            <label class="form-label">Search Device</label>

            <input type="text"
                   name="searchString"
                   value="@searchString"
                   class="form-control"
                   placeholder="Enter name or device code..." />
        </div>

        <!-- Filter by Category -->
        <div class="col-md-3">
            <label class="form-label">Category</label>

            <select name="categoryId"
                    asp-items="ViewBag.Categories"
                    class="form-select">
                <option value="">All Categories</option>
            </select>
        </div>

        <!-- Filter by Status -->
        <div class="col-md-3">
            <label class="form-label">Status</label>

            <select name="status" class="form-select">
                <option value="">All Statuses</option>

                <option value="1"
                        selected="@(selectedStatus == DeviceStatus.InUse)">
                    In use
                </option>

                <option value="2"
                        selected="@(selectedStatus == DeviceStatus.Broken)">
                    Broken
                </option>

                <option value="3"
                        selected="@(selectedStatus == DeviceStatus.UnderMaintenance)">
                    Under maintenance
                </option>
            </select>
        </div>

        <!-- Buttons -->
        <div class="col-md-2 d-flex align-items-end gap-2">
            <button type="submit" class="btn btn-primary">
                Search
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Reset
            </a>
        </div>

    </div>
</form>

<!-- DEVICE LIST -->
<h4>Device List (@Model.Count())</h4>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Device Name</th>
            <th>Device Code</th>
            <th>Category</th>
            <th>Status</th>
            <th>Date of Entry</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var device in Model)
        {
            <tr>
                <td>@device.Id</td>
                <td>@device.Name</td>
                <td>@device.Code</td>
                <td>@device.Category?.Name</td>

                <td>
                    @switch (device.Status)
                    {
                        case DeviceStatus.InUse:
                            <span class="badge bg-success">
                                In use
                            </span>
                            break;

                        case DeviceStatus.Broken:
                            <span class="badge bg-danger">
                                Broken
                            </span>
                            break;

                        case DeviceStatus.UnderMaintenance:
                            <span class="badge bg-warning text-dark">
                                Under maintenance
                            </span>
                            break;
                    }
                </td>

                <td>
                    @device.DateOfEntry.ToString("dd/MM/yyyy")
                </td>

                <td>
                    <a asp-action="Edit"
                       asp-route-id="@device.Id"
                       class="btn btn-warning btn-sm">
                        Edit
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@device.Id"
                       class="btn btn-danger btn-sm">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No devices found matching your search criteria.
    </div>
}